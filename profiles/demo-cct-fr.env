# CCT demo profile: `make demo-cct CORPUS=<folder of one agreement>`.
# The settings the prospection bench measured on French collective labour agreements.
# No secret here: the provider key stays in .env, and `make demo-cct` reads it only
# with LIVE=1. Sourced by a shell (set -a), so quote any value with a space.

VERITY_LANGUAGE=fr
VERITY_CHUNKING=articles
VERITY_INDEX_TABLES=true
VERITY_NAME_ARTICLES=true
VERITY_RETRIEVE_ORIGINAL_QUESTION=true
VERITY_COMPLETE_ANSWERS=false
VERITY_LLM_TEMPERATURE=0
# A complete answer on an agreement can need more than the default cap of 512; a draft
# cut off at the cap loses its citations and is refused.
VERITY_SYNTHESIS_MAX_TOKENS=1024
# A member's view in front of a client: no model, scores, costs or ids. Developer
# read-outs come back with VERITY_UI_MODE=developer.
VERITY_UI_MODE=presentation
VERITY_REFUSAL_TEXT="Les documents fournis ne permettent pas de répondre. Contactez le secrétariat de l'association."

# In memory, not pgvector: no Docker on the meeting laptop, and only this agreement is
# indexed (the pgvector store keeps every corpus served before it).
VERITY_STORE=memory
# The API binds 127.0.0.1; the demo has no other client.
VERITY_API_AUTH_DISABLED=true
