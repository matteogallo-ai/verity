# Copy to .env and fill in. Local embeddings + reranker need NO keys — the eval suite
# and CI run fully offline. Keys are only needed for real answer generation.

VERITY_DATABASE_URL=postgresql://verity:verity@localhost:5432/verity

# LLM providers (optional for retrieval/eval-CI; required for live answering)
VERITY_ANTHROPIC_API_KEY=
VERITY_OPENAI_API_KEY=

# Behaviour knobs (defaults live in verity/config.py)
VERITY_CONFIDENCE_THRESHOLD=0.55
VERITY_RETRIEVAL_K=20
VERITY_RERANK_K=8
VERITY_LOG_LEVEL=INFO
